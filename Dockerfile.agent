# ---------- Build stage ----------
FROM golang:1.25-alpine AS builder

RUN apk add --no-cache make git ca-certificates

WORKDIR /src

COPY Makefile go.mod go.sum ./
RUN go mod download

COPY . .
RUN make build-agent DEFAULT_DATA_PATH=/data

# ---------- Runtime stage ----------
FROM scratch

COPY --from=builder /src/bin/dockvmap-agent /dockvmap-agent

VOLUME ["/data"]

ENTRYPOINT ["/dockvmap-agent"]
