# ---------- Build stage ----------
# runs on the build host and cross-compiles, so an arm64 image needs no emulation
FROM --platform=$BUILDPLATFORM golang:1.25-alpine AS builder

ARG TARGETOS
ARG TARGETARCH

RUN apk add --no-cache make git ca-certificates

WORKDIR /src

COPY Makefile go.mod go.sum ./
RUN go mod download

COPY . .
RUN GOOS=${TARGETOS} GOARCH=${TARGETARCH} make build-agent DEFAULT_DATA_PATH=/data

# ---------- Runtime stage ----------
FROM scratch

COPY --from=builder /src/bin/dockvmap-agent /dockvmap-agent

VOLUME ["/data"]

ENTRYPOINT ["/dockvmap-agent"]
